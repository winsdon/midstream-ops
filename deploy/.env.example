# =============================================================================
# midstream-ops 环境变量
# =============================================================================
# 用法：cp .env.example .env 后按下方填写。.env 含真实凭据，已在 .gitignore 中。
# =============================================================================

# 镜像（本地构建后可改成 midstream-ops:dev 试跑）
MONITOR_IMAGE=winsdon8/midstream-ops:latest

# -----------------------------------------------------------------------------
# 监听
# -----------------------------------------------------------------------------
# 默认只绑本机。本站含成本 / 利润 / 客户授信 / KYC 等敏感数据，
# 不要改成 0.0.0.0 直接裸露公网 —— 对外请走宿主机反代 + TLS + 访问控制。
BIND_HOST=127.0.0.1
MONITOR_PORT=9090

# 须与 sub2api 主站的 timezone 一致，否则「今日」口径与对账会错位
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 登录账号
# -----------------------------------------------------------------------------
MONITOR_AUTH_USERNAME=admin
# 明文即可；填 $2a$ / $2b$ 开头则按 bcrypt 校验
MONITOR_AUTH_PASSWORD=
MONITOR_AUTH_TOKEN_TTL_HOURS=24

# -----------------------------------------------------------------------------
# 密钥（必填）
# -----------------------------------------------------------------------------
# JWT 签名密钥，须 ≥32 字节。留空或过短会直接启动失败。
#   生成：openssl rand -hex 32
MONITOR_AUTH_JWT_SECRET=

# 凭据与 PII 加密密钥，须为 base64 编码的 32 字节。
#   生成：openssl rand -base64 32
#
# ⚠️ 强烈建议首次部署就配好。原因：
#   • 不配置时，供应商站点登录密码、KYC 的身份证号等 PII 会【明文】存进 SQLite
#     （程序只在启动日志里告警，不会阻止启动）
#   • 后期再补配不会炸：代码按 enc:v1: 前缀自动兼容新旧数据，
#     但已有明文不会自动加密，会形成新旧混存
#   • 【换密钥会让旧密文永久无法解密】—— 请妥善备份此密钥
MONITOR_CREDENTIALS_KEY=

# -----------------------------------------------------------------------------
# 上游 sub2api Postgres（只读连接）
# -----------------------------------------------------------------------------
# 与 sub2api 同宿主并接入其网络时，填它的 postgres 容器名即可（默认 sub2api-postgres）。
# 连远程库则填 IP/域名，并建议把 SSLMODE 改成 require。
MONITOR_SUB2API_DB_HOST=sub2api-postgres
MONITOR_SUB2API_DB_PORT=5432
MONITOR_SUB2API_DB_DBNAME=sub2api
MONITOR_SUB2API_DB_SSLMODE=disable

# 建议专门建只读账号（程序侧 DSN 已强制 default_transaction_read_only=on，
# 加上账号权限构成双保险）：
#
#   CREATE USER monitor_ro WITH PASSWORD '<强密码>';
#   GRANT CONNECT ON DATABASE sub2api TO monitor_ro;
#   GRANT USAGE ON SCHEMA public TO monitor_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO monitor_ro;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO monitor_ro;
MONITOR_SUB2API_DB_USER=monitor_ro
MONITOR_SUB2API_DB_PASSWORD=

# -----------------------------------------------------------------------------
# sub2api 的 docker 网络名（必须先确认真实名字）
# -----------------------------------------------------------------------------
# compose 会给网络加项目名前缀，真实名字通常是 <sub2api部署目录名>_sub2api-network。
# 先查再填：
#     docker network ls | grep sub2api
SUB2API_NETWORK=sub2api_sub2api-network

# -----------------------------------------------------------------------------
# 采集周期（分钟，可选）
# -----------------------------------------------------------------------------
MONITOR_BALANCE_INTERVAL_MINUTES=30
MONITOR_COST_INTERVAL_MINUTES=10
MONITOR_COST_RETENTION_DAYS=180
MONITOR_PROBE_INTERVAL_MINUTES=15
MONITOR_RATES_INTERVAL_MINUTES=5

# -----------------------------------------------------------------------------
# 模型广场 / KYC 嵌入页（可选，默认关闭）
# -----------------------------------------------------------------------------
# 开启后可把只读价格页以 iframe 嵌进 sub2api 的自定义菜单。
# 开启时下面两项必填，且 JWT_SECRET 须与 sub2api 的 jwt.secret 完全一致。
MONITOR_PLAZA_ENABLED=false
MONITOR_PLAZA_SUB2API_BASE_URL=
MONITOR_PLAZA_SUB2API_JWT_SECRET=

MONITOR_LOG_LEVEL=info
